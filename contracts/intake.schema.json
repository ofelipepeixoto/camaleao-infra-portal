{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Camaleão Infra Intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "sensitivity", "external_processing_allowed", "existing_tools", "users", "monthly_budget_brl"],
  "properties": {
    "goal": {"type": "string", "enum": ["documents", "process", "support"]},
    "sensitivity": {"type": "string", "enum": ["normal", "restricted"]},
    "external_processing_allowed": {"type": "boolean"},
    "existing_tools": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "users": {"type": "integer", "minimum": 1, "maximum": 100000},
    "monthly_budget_brl": {"type": ["integer", "null"], "minimum": 0}
  }
}
